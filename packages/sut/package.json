{
  "name": "sut",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vue-tsc --noEmit -p .",
    "test:unit": "vitest run --project unit",
    "test:contract": "vitest run --project contract",
    "test:skeleton": "vitest run --project skeleton",
    "test:bdd": "NODE_OPTIONS=--import=tsx cucumber-js",
    "test:wip": "NODE_OPTIONS=--import=tsx cucumber-js --profile wip"
  },
  "devDependencies": {
    "@app/types": "workspace:*",
    "@cucumber/cucumber": "^13.2.1",
    "@nestjs/common": "^12.1.0",
    "@nestjs/core": "^12.1.0",
    "@nestjs/event-emitter": "^12.0.1",
    "@nestjs/platform-express": "^12.1.0",
    "@nestjs/testing": "^12.1.0",
    "@pinia/testing": "^2.0.1",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@swc/core": "^1.16.2",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/compiler-dom": "^3.5.43",
    "@vue/test-utils": "^2.5.1",
    "drizzle-orm": "^0.45.3",
    "fast-check": "4.10.2",
    "jsdom": "^30.1.1",
    "pg": "^8.23.0",
    "pinia": "^4.0.3",
    "playwright": "^1.63.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "unplugin-swc": "^2.0.0",
    "uuid": "^14.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "vitest-mock-extended": "^5.1.1",
    "vue": "^3.5.43",
    "vue-tsc": "^3.3.11"
  }
